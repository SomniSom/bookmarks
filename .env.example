# Локальный go-запуск
LISTEN=127.0.0.1:8080
DB_PATH=./data/bookmarks.sqlite
BACKUP_DIR=./backups

# Docker Compose (на сервере достаточно этого файла рядом с docker-compose.yml)
BOOKMARKS_PASSWORD=
COOKIE_SECRET=
TRUSTED_PROXY=0
# 1 — не ходить за OG и проверкой ссылок в localhost/приватные сети
BLOCK_PRIVATE_URLS=0
# BOOKMARKS_IMAGE=ghcr.io/somnisom/bookmarks:latest

# Firefox unlisted-подпись (не витрина AMO). Ключи: https://addons.mozilla.org/developers/addon/api/key/
# WEB_EXT_API_KEY=user:12345678:123
# WEB_EXT_API_SECRET=
